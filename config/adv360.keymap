#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    macros {
        bs_func: bs_func {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SPACE &kp EQUAL &kp SPACE &kp LPAR &kp RPAR &kp SPACE &kp EQUAL &kp GT &kp LBRC &kp RIGHT_BRACE &kp LEFT>;
            label = "BS_FUNC";
        };

        bs_asc_func: bs_asc_func {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SPACE &kp EQUAL &kp SPACE &kp A &kp S &kp Y &kp N &kp C &kp LPAR &kp RPAR &kp SPACE &kp EQUAL &kp GT &kp LBRC &kp RIGHT_BRACE &kp LEFT>;
            label = "BS_ASC_FUNC";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp CAPSLOCK  &kp N1            &kp N2        &lt 2 NUMBER_3    &kp N4     &kp N5  &kp C_NEXT                                                                                  &mo 4              &kp N6  &kp N7    &kp N8     &kp N9     &kp N0    &kp BACKSLASH
&kp TAB       &kp Q             &kp W         &kp E             &kp R      &kp T   &kp C_PLAY_PAUSE                                                                            &kp LEFT_BRACKET   &kp Y   &kp U     &kp I      &kp O      &kp P     &kp EQUAL
&kp ESC       &kp A             &kp S         &kp D             &kp F      &kp G   &mo 1             &kp ENTER         &kp LS(LA(F))         &mo 2              &kp BACKSPACE  &kp RIGHT_BRACKET  &kp H   &kp J     &kp K      &kp L      &kp SEMI  &kp SINGLE_QUOTE
&kp LSHFT     &kp Z             &kp X         &kp C             &kp V      &kp B                                       &kp LEFT_ALT          &kp PG_UP                                            &kp N   &kp M     &kp COMMA  &kp DOT    &kp FSLH  &kp RSHFT
&to 3         &kp LEFT_CONTROL  &kp LEFT_ALT  &kp LEFT_COMMAND  &kp GRAVE          &kp BSPC          &kp LEFT_COMMAND  &kp LEFT_CONTROL      &kp RIGHT_COMMAND  &kp ENTER      &kp SPACE                  &kp LEFT  &kp DOWN   &kp RIGHT  &kp UP    &kp MINUS
            >;
        };

        keypad {
            display-name = "Kp";
            bindings = <
&kp EQUAL  &kp N1     &kp N2    &kp N3    &kp N4     &kp N5  &trans                                                   &mo 4      &kp N6  &kp KP_NUM  &kp KP_EQUAL  &kp KP_DIVIDE  &kp KP_MULTIPLY  &kp MINUS
&kp TAB    &kp Q      &kp W     &kp E     &kp R      &kp T   &none                                                    &none      &kp Y   &kp KP_N7   &kp KP_N8     &kp KP_N9      &kp KP_MINUS     &kp BSLH
&kp ESC    &kp A      &kp S     &kp D     &kp F      &kp G   &none     &kp LCTRL  &kp LALT      &kp LGUI   &kp RCTRL  &none      &kp H   &kp KP_N4   &kp KP_N5     &kp KP_N6      &kp KP_PLUS      &kp SQT
&kp LSHFT  &kp Z      &kp X     &kp C     &kp V      &kp B                        &kp HOME      &kp PG_UP                        &kp N   &kp KP_N1   &kp KP_N2     &kp KP_N3      &kp KP_ENTER     &kp RSHFT
&mo 2      &kp GRAVE  &kp CAPS  &kp LEFT  &kp RIGHT          &kp BSPC  &kp DEL    &kp END       &kp PG_DN  &kp ENTER  &kp KP_N0          &kp UP      &kp DOWN      &kp KP_DOT     &kp RBKT         &mo 2
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &tog 1                                              &mo 4              &kp F7         &kp F8          &kp F9                &kp F10                &kp F11            &kp F12
&trans  &trans  &trans  &trans  &trans  &trans  &none                                               &kp C_VOLUME_UP    &trans         &bs_func        &bs_asc_func          &trans                 &trans             &trans
&trans  &trans  &trans  &trans  &trans  &trans  &kp C_PREVIOUS  &trans  &trans      &trans  &trans  &kp C_VOLUME_DOWN  &kp DOLLAR     &kp LEFT_BRACE  &kp RIGHT_BRACE       &kp LEFT_BRACKET       &kp RIGHT_BRACKET  &trans
&trans  &trans  &trans  &trans  &trans  &trans                          &trans      &trans                             &kp AMPERSAND  &kp KP_EQUAL    &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp GREATER_THAN   &kp PIPE
&trans  &trans  &trans  &trans  &trans          &trans          &trans  &trans      &trans  &trans  &trans                            &trans          &trans                &trans                 &trans             &trans
            >;
        };

        FN_2 {
            display-name = "2";
            bindings = <
&kp F1          &kp F2        &kp F3            &kp LG(R)           &kp LG(LEFT_ARROW)  &kp LG(RIGHT)      &tog 1                                                               &mo 4              &kp F7  &kp F8    &kp F9    &kp F10    &kp F11       &kp F12
&kp TAB         &kp LC(DOWN)  &kp LC(UP_ARROW)  &kp LC(LEFT_ARROW)  &kp LC(RIGHT)       &kp LC(LA(LG(S)))  &none                                                                &kp C_VOLUME_UP    &trans  &trans    &trans    &trans     &trans        &trans
&kp ESC         &kp LG(A)     &kp LG(S)         &mkp RCLK           &mkp LCLK           &kp LA(LS(F))      &kp C_PREVIOUS  &kp ENTER         &kp SPACE          &trans  &trans  &kp C_VOLUME_DOWN  &trans  &trans    &trans    &trans     &trans        &trans
&kp LEFT_SHIFT  &kp LG(Z)     &kp LG(X)         &kp LG(C)           &kp LG(V)           &kp LG(SLASH)                                        &trans             &trans                             &trans  &trans    &trans    &trans     &trans        &trans
&to 0           &trans        &kp DOWN          &kp UP_ARROW        &kp LG(GRAVE)                          &kp DEL         &kp LEFT_COMMAND  &kp LG(RS(Z))      &trans  &trans  &trans                     &kp LEFT  &kp DOWN  &kp RIGHT  &kp UP_ARROW  &trans
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &stp STP_BAT     &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &macro_ver    &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };

        layer_9 {
            display-name = "Base";
            bindings = <
&kp CAPSLOCK  &kp N1            &kp N2        &kp N3            &kp N4     &kp N5  &kp C_NEXT                                                                                  &mo 4              &kp N6  &kp N7    &kp N8     &kp N9     &kp N0    &kp BACKSLASH
&kp TAB       &kp Q             &kp W         &kp E             &kp R      &kp T   &kp C_PLAY_PAUSE                                                                            &kp LEFT_BRACKET   &kp Y   &kp U     &kp I      &kp O      &kp P     &kp EQUAL
&kp ESC       &kp A             &kp S         &kp D             &kp F      &kp G   &mo 1             &kp ENTER         &kp LS(LA(F))         &mo 2              &kp BACKSPACE  &kp RIGHT_BRACKET  &kp H   &kp J     &kp K      &kp L      &kp SEMI  &kp SINGLE_QUOTE
&kp LSHFT     &kp Z             &kp X         &kp C             &kp V      &kp B                                       &kp LEFT_ALT          &kp PG_UP                                            &kp N   &kp M     &kp COMMA  &kp DOT    &kp FSLH  &kp RSHFT
&mo 2         &kp LEFT_CONTROL  &kp LEFT_ALT  &kp LEFT_COMMAND  &kp GRAVE          &kp BSPC          &kp LEFT_COMMAND  &kp LEFT_CONTROL      &kp RIGHT_COMMAND  &kp ENTER      &kp SPACE                  &kp LEFT  &kp DOWN   &kp RIGHT  &kp UP    &kp MINUS
            >;
        };

        extra1 {
            display-name = "Red";
            status = "reserved";
        };

        extra2 {
            display-name = "Purple";
            status = "reserved";
        };

        extra3 {
            display-name = "Cyan";
            status = "reserved";
        };

        extra4 {
            display-name = "Yellow";
            status = "reserved";
        };
    };
};
